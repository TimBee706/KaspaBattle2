# KaspaBattle — Docker Compose Environment
#
# SETUP: cp .env.docker.example .env.production
#        cp .env.docker.example .env
#   (or: cp .env.docker.example .env.production && ln -sf .env.production .env)
#
# Why two files: `docker-compose.yml` uses `.env` for its own ${VAR} substitution
# (POSTGRES_*, DOMAIN, TLS_EMAIL, FRONTEND_BUILD_TARGET, ...), while the backend
# container gets its runtime environment from `.env.production` via `env_file:`.
# Keep both in sync (or symlink) — see DEPLOYMENT_IONOS_DOCKER.md.
#
# ⚠️  NEVER commit .env / .env.production / .env.docker to version control
#     (all already in .gitignore).
# ⚠️  Rotate every mnemonic and secret below before going anywhere near
#     mainnet funds — the values here are placeholders only.

RUST_ENV=production

# TEST_MODE must be FALSE in Docker/staging/production!
TEST_MODE=false

# ==========================================
# App Settings
# ==========================================
POSTGRES_USER=kaspabattle
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=kaspabattle
# DATABASE_URL below is only used for non-Docker (`cargo run`) local dev — keep
# it in sync with POSTGRES_* above by hand (env_file: values are NOT variable-
# interpolated, so ${POSTGRES_USER}-style references here would NOT expand).
# Inside docker-compose, the backend service's DATABASE_URL is always built
# from POSTGRES_* directly in docker-compose.yml's `environment:` block, which
# overrides this line — pointing at the `postgres` service, not localhost.
DATABASE_URL=postgres://kaspabattle:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/kaspabattle
PORT=8080

# ── Kaspa Integration — no own node, external RPC only ──────────────────────
# Leave KASPA_USE_EXPLICIT_NODE=false to use Kaspa's public Resolver (default,
# no operator action needed). Set to true + KASPA_NODE_URL only if you have a
# specific RPC provider/node to pin to. Prefer wss:// over ws:// whenever your
# provider supports it — plaintext ws:// is a known weak point, see
# DEPLOYMENT_IONOS_DOCKER.md and the project's SilverScript/security analysis.
KASPA_USE_EXPLICIT_NODE=false
# KASPA_NODE_URL=wss://your-kaspa-rpc-provider.example:17110
KASPA_NETWORK=testnet-10

# Generate fresh mnemonics for every environment — never reuse across envs!
KASPA_MNEMONIC="CHANGE_ME_12_WORD_ESCROW_MNEMONIC"
TREASURY_MNEMONIC="CHANGE_ME_12_WORD_TREASURY_MNEMONIC"

# ── FACEIT OAuth ─────────────────────────────────────────────────────────────
FACEIT_CLIENT_ID=YOUR_FACEIT_CLIENT_ID_HERE
FACEIT_CLIENT_SECRET=YOUR_FACEIT_CLIENT_SECRET_HERE
# Must equal, character for character, the redirect URI registered in the FACEIT Developer
# Portal (scheme, www, no port, path, no trailing slash) and the canonical FRONTEND_URL origin.
# Caddy routes this path to the backend, which sets the cookie and 303-redirects to /lobby.
FACEIT_REDIRECT_URI=https://www.your-domain.example/auth/faceit/callback

# ── CORS / Frontend origin ───────────────────────────────────────────────────
# FRONTEND_URL is the legacy single-origin fallback; CORS_ALLOWED_ORIGINS (comma
# separated) is preferred and lets you allow multiple origins (e.g. apex + www).
FRONTEND_URL=https://www.your-domain.example
CORS_ALLOWED_ORIGINS=https://www.your-domain.example,https://your-domain.example

# ── Rate limiting behind the reverse proxy ───────────────────────────────────
# Behind Caddy every request arrives from the proxy's container IP, so WITHOUT this flag all
# users share ONE per-IP bucket (e.g. 3 match creations/min for the whole site). Set it to
# true only when the backend is reachable exclusively through Caddy (compose binds 8080 to
# 127.0.0.1); the last X-Forwarded-For entry (appended by Caddy) is then used as client IP.
# RATE_LIMIT_AUTH_RPM / RATE_LIMIT_GLOBAL_RPM / RATE_LIMIT_MATCH_RPM tune the limits.
TRUST_X_FORWARDED_FOR=true

# ── Oracle Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ORACLE_API_KEYS=CHANGE_ME_KEY_1,CHANGE_ME_KEY_2

# ── Admin API ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# ── Oracle Multisig (REQUIRED — startup fails without this!) ─────────────────
# Generate with: openssl rand -hex 32
ORACLE_PRIVATE_KEY=CHANGE_ME_ORACLE_PRIVATE_KEY

# ── Multisig Key Derivation Secret (REQUIRED — startup fails without this!) ──
# SEC-MULTISIG-01: keys the derivation of both players' escrow keys so they are
# not reconstructable from the public match ID alone. Generate with:
# openssl rand -hex 32 — NEVER reuse across environments, and never reuse
# ORACLE_PRIVATE_KEY here.
MULTISIG_KEY_DERIVATION_SECRET=CHANGE_ME_MULTISIG_KEY_DERIVATION_SECRET

# ── FaceIT Webhook ───────────────────────────────────────────────────────────
FACEIT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ==========================================
# docker-compose-only settings (read via ${VAR} substitution, not by the app)
# ==========================================
# "dev" = Vite dev server (local testing, default). "prod" = optimized static
# build served via `serve` — use this on the IONOS server.
FRONTEND_BUILD_TARGET=dev

# Vite build-time URLs baked into the frontend bundle. Defaults target a local
# backend on localhost:8080; override for a real deployment domain.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=wss://www.your-domain.example/ws
# Leave unset unless the browser talks to the Kaspa node directly (see
# Caddyfile.example, /kaspa-rpc) — recommended default is to route all Kaspa
# RPC through the backend instead.
# Own private TN10 node through the Caddy /kaspa-rpc route (baked in at BUILD time, so the
# frontend image must be rebuilt after changing it). Never a plaintext ws://<ip> URL.
# VITE_KASPA_NODE_URL=wss://www.your-domain.example/kaspa-rpc
VITE_KASPA_NODE_URL=
# Set to true to allow the public Resolver when the own node fails (default: no silent fallback).
# VITE_KASPA_PUBLIC_FALLBACK=false

# Public contact email shown on the landing page footer (mailto: link).
# Only rendered if set — leave empty to fall back to a "report on GitHub" CTA.
# NEVER a private/personal address — see battle-frontend/.env.example.
VITE_PUBLIC_CONTACT_EMAIL=info@kaspabattle.com

# Only needed for the `caddy` service (--profile proxy, i.e. real deployments).
DOMAIN=your-domain.example
TLS_EMAIL=you@your-domain.example
# Upstream of the Caddyfile's /kaspa-rpc route, e.g. http://<NODE-IP>:17210 (TN10 Borsh wRPC).
KASPA_RPC_HTTP_TARGET=

# ── Free Play / accounts (e-mail + password) ────────────────────────────────
# Public base URL used in verification / reset links.
# PUBLIC_APP_URL=https://www.your-domain.example
# SMTP delivery (verification + password reset). NEVER commit real values; leave unset to disable mail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=info@your-domain.example
# SMTP_FROM_NAME=Kaspa Battle
# SMTP_TLS_MODE=starttls   # starttls | tls | none (none only for local test servers)
# Require a confirmed e-mail before login. Set to false ONLY as a temporary fallback while SMTP is not
# working (profile then shows "E-Mail noch nicht bestätigt"); switch back to true once mail works.
# REQUIRE_EMAIL_VERIFICATION=true
# Salt for hashed IPs in audit logs (random string).
# AUDIT_IP_SALT=
