# KaspaBattle — Docker Compose Environment
# SETUP: cp .env.docker.example .env.docker  and fill in your values.
#
# ⚠️  NEVER commit .env.docker to version control (it is in .gitignore).
# ⚠️  Rotate all mnemonics and secrets below before going to production.

RUST_ENV=development

# TEST_MODE must be FALSE in Docker/staging/production!
TEST_MODE=false

# ==========================================
# App Settings
# ==========================================
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/kaspabattle
PORT=8080
FRONTEND_URL=http://localhost:5173

# ── Kaspa Integration (uses Docker service name) ────────────────────────────
# KASPA_NODE_URL=  # Leave empty to use Kaspa Resolver (recommended for Beta)
KASPA_USE_EXPLICIT_NODE=false
KASPA_NETWORK=testnet-12

# Generate fresh mnemonics for every environment!
KASPA_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
TREASURY_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# ── FACEIT OAuth ─────────────────────────────────────────────────────────────
FACEIT_CLIENT_ID=YOUR_FACEIT_CLIENT_ID_HERE
FACEIT_CLIENT_SECRET=YOUR_FACEIT_CLIENT_SECRET_HERE
FACEIT_REDIRECT_URI=http://localhost:5173/auth/faceit/callback
FRONTEND_URL=http://localhost:5173

# ── Oracle Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ORACLE_API_KEYS=CHANGE_ME_KEY_1,CHANGE_ME_KEY_2

# ── Admin API ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# ── Oracle Multisig (REQUIRED — startup fails without this!) ─────────────────
# Generate with: openssl rand -hex 32
ORACLE_PRIVATE_KEY=CHANGE_ME_ORACLE_PRIVATE_KEY

# ── FaceIT Webhook ───────────────────────────────────────────────────────────
FACEIT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
