# Pin an exact release, ideally with digest: e.g. <registry>/<image>:<version>@sha256:<digest>
KASPAD_IMAGE=
# IP the wRPC port is published on. Use the interface reachable by the Kaspa Battle server
# (never 0.0.0.0 without a firewall rule limiting 17210 to that server's IP).
RPC_BIND_IP=127.0.0.1
