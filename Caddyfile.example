# ─── KaspaBattle Production Reverse Proxy ─────────────────────────────────────
# Caddy handles HTTPS (Let's Encrypt) automatically.
# Canonical domain: www.kaspabattle.com (with www)

# Redirect non-www → www (single canonical origin for cookies & CORS)
kaspabattle.com {
	redir https://www.kaspabattle.com{uri} permanent
}

www.kaspabattle.com {
	tls timo.beermann98@gmail.com

	# ── API: preserve full path, proxy to backend ──────────────────────────
	handle /api/* {
		reverse_proxy backend:8080
	}

	# ── WebSocket (Backend): /ws und /ws/* matchen ──────────────────────────
	# /ws/* matcht NICHT /ws exakt — beide Varianten nötig
	handle /ws {
		reverse_proxy backend:8080
	}
	handle /ws/* {
		reverse_proxy backend:8080
	}

	# ── Kaspa wRPC Proxy (Browser → Node) ───────────────────────────────────
	# Browser-WASM kann kein ws:// über https:// nutzen (mixed content).
	# Caddy terminiert TLS und leitet als plain WS weiter.
	handle /kaspa-rpc {
		reverse_proxy ws://217.160.255.235:17110
	}

	# ── Frontend SPA: everything else ──────────────────────────────────────
	handle {
		reverse_proxy frontend:5173
	}

	# Compression
	encode gzip zstd
}
