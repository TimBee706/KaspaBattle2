# ─── KaspaBattle Production Reverse Proxy ─────────────────────────────────────
# Caddy handles HTTPS (Let's Encrypt) automatically.
#
# Setup on the server:
#   1. cp Caddyfile.example Caddyfile
#   2. Set DOMAIN and TLS_EMAIL in .env (docker-compose's own ${VAR}-substitution
#      file — NOT .env.production, which only feeds the backend container's own
#      runtime env). Compose passes them into the `caddy` service's environment,
#      see docker-compose.yml.
#   3. Start with the proxy profile enabled: docker-compose --profile proxy up -d
#
# DOMAIN/TLS_EMAIL below are read from the container environment via Caddy's
# {$VAR} placeholder syntax — nothing is hardcoded in this file.

# Redirect bare domain -> www (single canonical origin for cookies & CORS).
# Remove this block if you don't use a www/non-www split for your domain.
{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}

www.{$DOMAIN} {
	tls {$TLS_EMAIL}

	# ── API: preserve full path, proxy to backend ──────────────────────────
	handle /api/* {
		reverse_proxy backend:8080
	}

	# ── FACEIT OAuth callback: same origin, served by the backend ──────────
	# The registered redirect URI stays https://www.<DOMAIN>/auth/faceit/callback (no FACEIT
	# portal change). The backend redeems the code, sets the HttpOnly session cookie and
	# answers 303 -> /lobby?linked=1. The query string (code/state) is preserved by rewrite.
	handle /auth/faceit/callback {
		rewrite * /api/v1/faceit/callback
		reverse_proxy backend:8080
	}

	# ── WebSocket (Backend): /ws und /ws/* matchen ──────────────────────────
	# /ws/* matcht NICHT /ws exakt — beide Varianten nötig
	handle /ws {
		reverse_proxy backend:8080
	}
	handle /ws/* {
		reverse_proxy backend:8080
	}

	# ── Kaspa Borsh-wRPC proxy (Browser -> private TN10 node) ────────────────
	# Browser (wss://www.<DOMAIN>/kaspa-rpc) -> Caddy terminates TLS -> plain WebSocket to the
	# node's Borsh wRPC listener. handle_path strips the "/kaspa-rpc" prefix, so the node
	# receives the WebSocket upgrade on "/", which is where kaspad serves wRPC.
	# KASPA_RPC_HTTP_TARGET example: http://<NODE-IP>:17210  (TN10 Borsh wRPC default; verify
	# against the installed rusty-kaspa version). Firewall the node so that port only accepts
	# connections from THIS server. Caddy proxies WebSocket upgrades natively; long-lived
	# connections are kept open (no response timeout is set for streamed upgrades).
	handle_path /kaspa-rpc {
		reverse_proxy {$KASPA_RPC_HTTP_TARGET} {
			transport http {
				dial_timeout 5s
			}
		}
	}

	# ── Frontend SPA: everything else ──────────────────────────────────────
	handle {
		reverse_proxy frontend:5173
	}

	# Compression
	encode gzip zstd
}
