# KaspaBattle Frontend — Vite Environment Variables
# SETUP: cp .env.example .env.local  and fill in your values.
#
# ⚠️  NEVER put real secrets in files tracked by git.
# Vite exposes all VITE_* variables to the browser bundle!
# Do NOT put private keys, mnemonics, or server secrets here.

# Backend API base URL (must match your backend port)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Backend WebSocket URL
VITE_WS_BASE_URL=ws://localhost:8080/ws

# FACEIT OAuth — Client ID is semi-public (safe to commit if needed)
# Obtain from https://developers.faceit.com/
VITE_FACEIT_CLIENT_ID=YOUR_FACEIT_CLIENT_ID_HERE

# Callback URL — must match exactly what FaceIT has configured
VITE_FACEIT_REDIRECT_URI=http://localhost:8080/api/v1/faceit/callback

# Kaspa node (frontend uses this for balance checks)
VITE_KASPA_NODE_URL=wss://photon-10.kaspa.red/kaspa/testnet-10/wrpc/borsh
VITE_KASPA_NETWORK=testnet-10
