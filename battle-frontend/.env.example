# KaspaBattle Frontend — Vite Environment Variables
# SETUP: cp .env.example .env.local  and fill in your values.
#
# ⚠️  NEVER put real secrets in files tracked by git.
# Vite exposes all VITE_* variables to the browser bundle!
# Do NOT put private keys, mnemonics, or server secrets here.

# Backend API base URL (must match your backend port)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Backend WebSocket URL
VITE_WS_BASE_URL=ws://localhost:8080/ws

# FACEIT OAuth — Client ID is semi-public (safe to commit if needed)
# Obtain from https://developers.faceit.com/
VITE_FACEIT_CLIENT_ID=YOUR_FACEIT_CLIENT_ID_HERE

# Callback URL — must match exactly what FaceIT has configured
VITE_FACEIT_REDIRECT_URI=http://localhost:5173/auth/faceit/callback

# Kaspa node (frontend uses this for balance checks)
# Leer lassen → nutzt automatisch den Kaspa RPC Resolver (empfohlen)
# Nur setzen wenn du eine eigene private Node betreibst, z.B.:
# VITE_KASPA_NODE_URL=ws://meine-ip:17110
# VITE_KASPA_NODE_URL=
VITE_KASPA_NETWORK=testnet-10

# Public contact email shown on the landing page / footer (mailto: link).
# Only rendered if this is set — leave empty to fall back to a "report on
# GitHub" call-to-action instead. Already-public project address found on the
# existing /support page; change it here if you'd rather use a different one.
# NEVER put a private/personal address here — this ships in the public bundle.
VITE_PUBLIC_CONTACT_EMAIL=info@kaspabattle.com

# Native browser games (Vier Gewinnt). The backend flag NATIVE_GAMES_ENABLED is the source of
# truth (the UI asks GET /features). Set this to "false" to force-hide the section in the UI.
# VITE_NATIVE_GAMES_ENABLED=true
