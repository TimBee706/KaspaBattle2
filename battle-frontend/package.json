{
  "name": "battle-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:strict": "vite --strictPort",
    "dev:mock-backend": "node scripts/mock-backend.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
