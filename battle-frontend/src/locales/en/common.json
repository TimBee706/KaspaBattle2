    "sections": {
        "what_is": "WHAT IS KASPABATTLE?",
        "what_is_content": "KaspaBattle is a decentralized <1>peer-to-peer gaming wager platform</1> on Kaspa. Two players deposit KAS into a secure multisig escrow (based on multi-signature transactions). After a match (e.g. CS2 on FACEIT), our automated oracle evaluates the result and the winner automatically receives the payout.",
        "how_it_works": "HOW A KASPA BATTLE WORKS",
        "how_it_works_steps": {
            "1": "CONNECT WALLET & FACEIT LOGIN",
            "2": "CREATE / ACCEPT CHALLENGE",
            "3": "DEPOSIT STAKE (Smart Contract Escrow)",
            "4": "PLAY MATCH (e.g. CS2 on FACEIT)",
            "5": "RESULT AUTOMATICALLY IMPORTED (Oracle)",
            "6": "AUTOMATIC PAYOUT (within seconds)"
        },
        "how_1vs1": {
            "title": "How your <1>KaspaBattle 1vs1</1> works",
            "subtitle": "Ready for some real competition? KaspaBattle uses Faceit to let you play seamless 1vs1 matches for KAS. Join our club, connect your accounts, and let the Multisig oracle handle the payout — 100% trustless, transparent, and bullshit-free.",
            "steps": {
                "1": {
                    "title": "Connect Faceit & Wallet",
                    "text": "Link your Faceit account with our platform and connect your Kaspa Wallet. This is required to track the match result and pay out your winnings.",
                    "btn_wallet": "Connect your Wallet",
                    "btn_faceit": "Connect your Faceit"
                },
                "2": {
                    "title": "Join or create a Lobby",
                    "text": "Head over to the <1>Lobby</1> and accept an open challenge. Or simply create a new challenge yourself and set your desired KAS wager."
                },
                "3": {
                    "title": "Deposit amount & wait for opponent",
                    "text": "Deposit your KAS stake into the match escrow. You might need to wait briefly until your opponent joins and the transaction is confirmed on the Kaspa network."
                },
                "4": {
                    "title": "Start Faceit 1vs1",
                    "text": "Now both of you switch to Faceit in our <1>KaspaBattle CS2 Club</1>. Join the <3>\"1 vs 1\"</3> club queue, start the match there and play against each other on the same server.",
                    "btn_club": "Join Club (Invite)",
                    "btn_queue": "Open 1vs1 Queue"
                },
                "5": {
                    "title": "Enter Match ID",
                    "text": "Once the match page is displayed on Faceit, one of you copies the Match ID from the Faceit matchroom and enters it on our site. This automatically links your match result."
                },
                "6": {
                    "title": "Play & automatic payout",
                    "text": "Tryhard mode on! Play your CS2 1vs1 match. After the match ends, our system determines the winner on-chain. The Kaspa pot is paid out completely non-custodially via a Kaspa Multisig transaction directly to their wallet (minus protocol fee). GG WP!"
                }
            }
        },
