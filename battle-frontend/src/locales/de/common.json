    "sections": {
        "what_is": "WAS IST KASPABATTLE?",
        "what_is_content": "KaspaBattle ist eine dezentrale <1>Peer-to-Peer Gaming-Wager-Plattform</1> auf Kaspa. Zwei Spieler zahlen KAS in einen sicheren Multisig-Escrow ein (basierend auf Multi-Signature Transaktionen). Nach einem Match (z.B. CS2 auf FACEIT) wertet unser automatisiertes Oracle das Ergebnis aus und der Gewinner erhält automatisch den Payout.",
        "how_it_works": "SO FUNKTIONIERT EIN KASPA BATTLE",
        "how_it_works_steps": {
            "1": "WALLET VERBINDEN & FACEIT LOGIN",
            "2": "CHALLENGE ERSTELLEN / ANNEHMEN",
            "3": "EINSATZ EINZAHLEN (Smart Contract Escrow)",
            "4": "MATCH SPIELEN (z.B. CS2 auf FACEIT)",
            "5": "ERGEBNIS AUTOMATISCH IMPORTIERT (Oracle)",
            "6": "AUSZAHLUNG AUTOMATISCH (innerhalb Sekunden)"
        },
        "how_1vs1": {
            "title": "So funktioniert dein <1>KaspaBattle 1vs1</1>",
            "subtitle": "Bereit für echte Competition? Mit KaspaBattle und Faceit spielst du nahtlose 1vs1-Matches um KAS. Tritt unserem Club bei, verbinde deine Accounts und lass das Multisig-Oracle die Auszahlung regeln – 100% vertrauenslos, transparent und ohne Bullshit.",
            "steps": {
                "1": {
                    "title": "Faceit & Wallet verbinden",
                    "text": "Verknüpfe dein Faceit-Konto mit unserer Plattform und verbinde deine Kaspa-Wallet (Reihenfolge ist egal). Das ist nötig, um das Match-Ergebnis zu tracken und den Gewinn an dich auszuzahlen.",
                    "btn_wallet": "Verbinde deine Wallet",
                    "btn_faceit": "Verbinde dein Faceit"
                },
                "2": {
                    "title": "Lobby beitreten oder erstellen",
                    "text": "Gehe in die <1>Lobby</1> und nimm eine offene Herausforderung an. Alternativ kannst du einfach selbst eine neue Challenge erstellen und deinen gewünschten KAS-Wetteinsatz festlegen."
                },
                "3": {
                    "title": "Betrag einzahlen & auf Gegner warten",
                    "text": "Zahle deinen KAS-Einsatz in den Match-Escrow ein. Du musst ggf. kurz warten, bis dein Gegner joint und die Transaktion im Kaspa-Netzwerk bestätigt ist."
                },
                "4": {
                    "title": "Faceit 1vs1 starten",
                    "text": "Wechselt jetzt beide zu Faceit in unseren <1>KaspaBattle CS2 Club</1>. In der Club Queue <3>„1 vs 1“</3> antreten, Match darüber starten und auf dem gleichen Server gegeneinander zocken.",
                    "btn_club": "Club beitreten (Invite)",
                    "btn_queue": "1vs1 Queue öffnen"
                },
                "5": {
                    "title": "Match-ID eintragen",
                    "text": "Sobald die Match-Seite auf Faceit angezeigt wird, kopiert einer von euch die Match-ID aus dem Faceit-Matchroom und trägt sie auf unserer Seite ein. So wird euer Match-Ergebnis automatisch verknüpft."
                },
                "6": {
                    "title": "Spielen & automatische Auszahlung",
                    "text": "Tryhard-Mode on! Spielt euer CS2 1vs1 zu Ende. Nach Match-Ende ermittelt unser System On-Chain den Gewinner. Der Kaspa-Pot geht komplett non-custodial via Kaspa Multisig-Transaktion direkt auf dessen Wallet (abzüglich Protokoll-Fee). GG WP!"
                }
            }
