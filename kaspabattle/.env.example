# KaspaBattle — Environment Configuration
# SETUP: cp .env.example .env  and fill in your own values.
#
# ⚠️  NEVER commit the actual .env file to version control.
# ⚠️  Rotate all mnemonics and secrets below before going to production.

# Mode: development | production
RUST_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local: postgres://postgres:yourpassword@localhost:5432/kaspabattle
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kaspabattle

# ── Kaspa Integration ────────────────────────────────────────────────────────
# Use Resolver by default (recommended). Set KASPA_USE_EXPLICIT_NODE=true to override.
KASPA_NETWORK=testnet-12
# KASPA_NODE_URL=wss://photon-10.kaspa.red/kaspa/testnet-12/wrpc/borsh
# KASPA_USE_EXPLICIT_NODE=false

# Escrow Wallet — BIP44 HD keys (generate a fresh mnemonic for each environment!)
# Generate with: kaspa-wallet create-mnemonic  or any BIP39 tool
KASPA_MNEMONIC="CHANGE_ME_WORD1 CHANGE_ME_WORD2 CHANGE_ME_WORD3 CHANGE_ME_WORD4 CHANGE_ME_WORD5 CHANGE_ME_WORD6 CHANGE_ME_WORD7 CHANGE_ME_WORD8 CHANGE_ME_WORD9 CHANGE_ME_WORD10 CHANGE_ME_WORD11 CHANGE_ME_WORD12"

# ── General ──────────────────────────────────────────────────────────────────
PORT=8080

# Primary frontend origin (backwards compat)
FRONTEND_URL=http://localhost:5173

# Multi-Origin CORS (SEC-02): comma-separated list of allowed origins.
# If set, overrides FRONTEND_URL for CORS/CSRF purposes.
# Example: CORS_ALLOWED_ORIGINS=https://kaspabattle.com,https://www.kaspabattle.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Rate Limiting (SEC-03) ───────────────────────────────────────────────────
# Requests per minute per IP address. Adjust as needed.
# Auth endpoints (wallet-challenge, wallet-verify, logout)
RATE_LIMIT_AUTH_RPM=30
# Match creation endpoint
RATE_LIMIT_MATCH_RPM=3
# All other API endpoints
RATE_LIMIT_GLOBAL_RPM=120

# ── Treasury Wallet (receives platform fee) ───────────────────────────────────
# Generate a SEPARATE, FRESH mnemonic for treasury!
TREASURY_MNEMONIC="CHANGE_ME_WORD1 CHANGE_ME_WORD2 CHANGE_ME_WORD3 CHANGE_ME_WORD4 CHANGE_ME_WORD5 CHANGE_ME_WORD6 CHANGE_ME_WORD7 CHANGE_ME_WORD8 CHANGE_ME_WORD9 CHANGE_ME_WORD10 CHANGE_ME_WORD11 CHANGE_ME_WORD12"

# ── Oracle Private Key (MANDATORY — no default allowed) ──────────────────────
# Generate with: openssl rand -hex 32
# CRITICAL: Must be set in ALL environments. Backend will panic on startup if missing.
ORACLE_PRIVATE_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Multisig Key Derivation Secret (MANDATORY — no default allowed) ──────────
# SEC-MULTISIG-01: keys the derivation of both players' escrow keys. Without a
# secret unique to this deployment, player keys were reconstructable by anyone
# who knew the (public) match ID — see battle-kaspa/src/multisig/service.rs.
# Generate with: openssl rand -hex 32 — NEVER reuse across environments,
# and never reuse ORACLE_PRIVATE_KEY here.
# CRITICAL: Must be set in ALL environments. Backend will panic on startup if missing.
MULTISIG_KEY_DERIVATION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── FACEIT OAuth ─────────────────────────────────────────────────────────────
# Obtain from https://developers.faceit.com/
FACEIT_CLIENT_ID=YOUR_FACEIT_CLIENT_ID_HERE
FACEIT_CLIENT_SECRET=YOUR_FACEIT_CLIENT_SECRET_HERE
FACEIT_REDIRECT_URI=http://localhost:5173/auth/faceit/callback

# ── FACEIT Data API ───────────────────────────────────────────────────────────
# Required for /faceit/profile and /faceit/stats endpoints
FACEIT_DATA_API_KEY=YOUR_FACEIT_DATA_API_KEY_HERE

# ── Oracle Auth ──────────────────────────────────────────────────────────────
# Comma-separated list of pre-shared API keys for oracle services
# Generate with: openssl rand -hex 32
ORACLE_API_KEYS=CHANGE_ME_KEY_1,CHANGE_ME_KEY_2

# ── Admin API ────────────────────────────────────────────────────────────────
# API key for admin-only endpoints (resolve match, etc.)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# ── FaceIT Webhook ───────────────────────────────────────────────────────────
# Webhook signing secret from FaceIT developer dashboard
FACEIT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
