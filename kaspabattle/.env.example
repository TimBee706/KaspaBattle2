# KaspaBattle — Environment Configuration
# SETUP: cp .env.example .env  and fill in your own values.
#
# ⚠️  NEVER commit the actual .env file to version control.
# ⚠️  Rotate all mnemonics and secrets below before going to production.

# Mode: development | production
RUST_ENV=development

# Set to "false" or remove before Beta / production.
# TEST_MODE bypasses ALL authentication — only for local unit tests!
TEST_MODE=false

# ── Database ────────────────────────────────────────────────────────────────
# Local: postgres://postgres:yourpassword@localhost:5432/kaspabattle
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kaspabattle

# ── Kaspa Integration ────────────────────────────────────────────────────────
# Public testnet node or your own local node
KASPA_NODE_URL=wss://photon-10.kaspa.red/kaspa/testnet-10/wrpc/borsh
KASPA_NETWORK=testnet-10

# Escrow Wallet — BIP44 HD keys (generate a fresh mnemonic for each environment!)
# Generate with: kaspa-wallet create-mnemonic  or any BIP39 tool
KASPA_MNEMONIC="CHANGE_ME_WORD1 CHANGE_ME_WORD2 CHANGE_ME_WORD3 CHANGE_ME_WORD4 CHANGE_ME_WORD5 CHANGE_ME_WORD6 CHANGE_ME_WORD7 CHANGE_ME_WORD8 CHANGE_ME_WORD9 CHANGE_ME_WORD10 CHANGE_ME_WORD11 CHANGE_ME_WORD12"

# ==========================================
# General
# ==========================================
PORT=8080
FRONTEND_URL=http://localhost:5173

# Treasury Wallet (receives 5% platform fee)
# Generate a SEPARATE, FRESH mnemonic for treasury!
TREASURY_MNEMONIC="CHANGE_ME_WORD1 CHANGE_ME_WORD2 CHANGE_ME_WORD3 CHANGE_ME_WORD4 CHANGE_ME_WORD5 CHANGE_ME_WORD6 CHANGE_ME_WORD7 CHANGE_ME_WORD8 CHANGE_ME_WORD9 CHANGE_ME_WORD10 CHANGE_ME_WORD11 CHANGE_ME_WORD12"

# ── FACEIT OAuth ─────────────────────────────────────────────────────────────
# Obtain from https://developers.faceit.com/
FACEIT_CLIENT_ID=YOUR_FACEIT_CLIENT_ID_HERE
FACEIT_CLIENT_SECRET=YOUR_FACEIT_CLIENT_SECRET_HERE
FACEIT_REDIRECT_URI=http://localhost:5173/auth/faceit/callback
FRONTEND_URL=http://localhost:5173

# ── Oracle Auth ──────────────────────────────────────────────────────────────
# Comma-separated list of pre-shared API keys for oracle services
# Generate with: openssl rand -hex 32
ORACLE_API_KEYS=CHANGE_ME_KEY_1,CHANGE_ME_KEY_2

# ── Admin API ────────────────────────────────────────────────────────────────
# API key for admin-only endpoints (resolve match, etc.)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# ── FaceIT Webhook ───────────────────────────────────────────────────────────
# Webhook signing secret from FaceIT developer dashboard
FACEIT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
