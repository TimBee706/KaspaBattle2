# KaspaBattle Environment Configuration
# Copy this file to .env and adjust values

# Mode: development | production
RUST_ENV=development

# Database
DATABASE_URL=sqlite:kaspabattle.db?mode=rwc

# Kaspa Integration
KASPA_NODE_URL=wss://photon-10.kaspa.red/kaspa/testnet-10/wrpc/borsh
KASPA_NETWORK=testnet-10
# KASPA_MNEMONIC="your 12 word phrase here"

# Security (Mandatory in production)
# TREASURY_ADDRESS=kaspatest:q...
# FACEIT_API_KEY=your-api-key

# FACEIT OAuth
FACEIT_CLIENT_ID=client_id
FACEIT_CLIENT_SECRET=secret
FACEIT_REDIRECT_URI=http://localhost:3000/api/v1/faceit/callback

# Oracle Auth (CSV list of authorized keys)
ORACLE_API_KEYS=key1,key2
